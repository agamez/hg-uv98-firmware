# Firmware binaries (keep source code, not all compiled binaries)
# Exceptions: firmware/ directory keeps copies of official firmware
# (see docs/FIRMWARE_INVENTORY.md for all available firmwares)
!firmware/*.hex
!firmware/*.bin
!firmware/*.zip
!firmware/*.rar
!firmware/*.exe
!firmware/**/*.docx
*.hex
*.bin
*.zip
*.rar
*.exe
*.doc
*.pdf
*.uvoptx
*.opt*
*.uvproj
*.uvprojx
*.uvs
*.bat
*.xlsx
*.xls

# Build artifacts
OBJ/
DAP/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# RE analysis artifacts (dumps, string lists, sector maps, tool workspaces)
analysis/
*.gzf
ghidra-project/
rea-ghidra-*/
reconstruction/build/