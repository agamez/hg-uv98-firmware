# ck2matrix-orig - the CK2 UART command matrix (generated by ck2matrix_gen.py;
# do not edit by hand - regenerate). The stimulus = IDENTICAL to the other
# image: the same 10 frames at the same virtual times, neutral content.
using sysbus
mach create "hguv98-orig"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006780
sysbus WriteDoubleWord 0x00000004 0x08044691
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadBinary @/home/sslayer/Proyectos/HG-UV98/firmware/MAIN-MCU-HG-UV98-V1.0.1-190416.bin 0x08004000
cpu AddHook 0x08042900 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(9, RegisterValue.Create(0x08040000, 32))"
showAnalyzer sysbus.usart2
echo "=== boot 10 ms ==="
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
echo "=== run to 0.5 s (the boot settle; the ISR receives from here) ==="
emulation RunFor "00:00:00.490"
echo "=== inject F1_a00_ok ==="
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; f = chr(36)+'A00,' + '0'*14 + ',' + chr(0)*512 + chr(13)+chr(10); assert len(f) >= 11; [u.WriteChar(ord(c)) for c in f]"
emulation RunFor "00:00:00.300"
echo "=== CK2CHK F1_a00_ok BEGIN ==="
sysbus ReadByte 0x20003A84
sysbus ReadByte 0x20003A85
sysbus ReadByte 0x20003A86
