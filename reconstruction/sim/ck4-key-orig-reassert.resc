# ck4-key-orig-reassert.resc — Round N probe: one bit2=0 poke at press time,
# then fine-grained dumps of 0x20005090..0x200050B0 to catch the re-assert.
using sysbus
mach create "ck4keyreassert"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006780
sysbus WriteDoubleWord 0x00000004 0x08044691
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadBinary @/home/sslayer/Proyectos/HG-UV98/firmware/MAIN-MCU-HG-UV98-V1.0.1-190416.bin 0x08004000
cpu AddHook 0x08042900 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(9, RegisterValue.Create(0x08040000, 32))"
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
emulation RunFor "00:00:01.990"
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 2330
echo "MARK press + single poke"
python 'm = emulationManager.CurrentEmulation.Machines[0]; m["sysbus"].WriteByte(0x20005096, m["sysbus"].ReadByte(0x20005096) & 0xFB); open("/tmp/opencode/ra0.bin","wb").write(bytes([m["sysbus"].ReadByte(0x20005096)]))'
emulation RunFor "00:00:00.010"
python 'm = emulationManager.CurrentEmulation.Machines[0]; open("/tmp/opencode/ra1.bin","wb").write(bytes([m["sysbus"].ReadByte(0x20005096)]))'
emulation RunFor "00:00:00.020"
python 'm = emulationManager.CurrentEmulation.Machines[0]; open("/tmp/opencode/ra2.bin","wb").write(bytes([m["sysbus"].ReadByte(0x20005096)]))'
emulation RunFor "00:00:00.030"
python 'm = emulationManager.CurrentEmulation.Machines[0]; open("/tmp/opencode/ra3.bin","wb").write(bytes([m["sysbus"].ReadByte(0x20005096)]))'
emulation RunFor "00:00:00.050"
python 'm = emulationManager.CurrentEmulation.Machines[0]; open("/tmp/opencode/ra4.bin","wb").write(bytes([m["sysbus"].ReadByte(0x20005096)]))'
emulation RunFor "00:00:00.100"
python 'm = emulationManager.CurrentEmulation.Machines[0]; open("/tmp/opencode/ra5.bin","wb").write(bytes([m["sysbus"].ReadByte(0x20005096)]))'
emulation RunFor "00:00:00.200"
python 'm = emulationManager.CurrentEmulation.Machines[0]; open("/tmp/opencode/ra6.bin","wb").write(bytes([m["sysbus"].ReadByte(0x20005096)]))'
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 0
echo "MARK release"
emulation RunFor "00:00:00.300"
quit
