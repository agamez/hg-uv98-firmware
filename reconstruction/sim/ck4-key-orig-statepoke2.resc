# ck4-key-orig-statepoke2.resc — Round N probe: bit2 of 0x20005096 re-asserts
# itself (session 56). Repeat the bit2=0 poke every ~100 ms during the code-10
# hold so a UI-task pass can catch it; dump the byte after each window.
using sysbus
mach create "ck4keypoke2"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006780
sysbus WriteDoubleWord 0x00000004 0x08044691
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadBinary @/home/sslayer/Proyectos/HG-UV98/firmware/MAIN-MCU-HG-UV98-V1.0.1-190416.bin 0x08004000
cpu AddHook 0x08042900 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(9, RegisterValue.Create(0x08040000, 32))"
cpu AddHook 0x08019fea "self.Log(LogLevel.Info, 'MAINMODE_TAKEN')"
cpu AddHook 0x0801a1e6 "self.Log(LogLevel.Info, 'V_vtable')"
cpu AddHook 0x0801a202 "self.Log(LogLevel.Info, 'V_vtable2')"
showAnalyzer sysbus.usart2
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
emulation RunFor "00:00:01.990"
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 2330
echo "MARK press code10 + pokes"
python 'm = emulationManager.CurrentEmulation.Machines[0]; m["sysbus"].WriteByte(0x20005096, m["sysbus"].ReadByte(0x20005096) & 0xFB); open("/home/sslayer/hguv98-sim/pk0.bin","wb").write(bytes([m["sysbus"].ReadByte(0x20005096)]))'
emulation RunFor "00:00:00.100"
python 'm = emulationManager.CurrentEmulation.Machines[0]; m["sysbus"].WriteByte(0x20005096, m["sysbus"].ReadByte(0x20005096) & 0xFB); open("/home/sslayer/hguv98-sim/pk1.bin","wb").write(bytes([m["sysbus"].ReadByte(0x20005096)]))'
emulation RunFor "00:00:00.100"
python 'm = emulationManager.CurrentEmulation.Machines[0]; m["sysbus"].WriteByte(0x20005096, m["sysbus"].ReadByte(0x20005096) & 0xFB); open("/home/sslayer/hguv98-sim/pk2.bin","wb").write(bytes([m["sysbus"].ReadByte(0x20005096)]))'
emulation RunFor "00:00:00.100"
python 'm = emulationManager.CurrentEmulation.Machines[0]; m["sysbus"].WriteByte(0x20005096, m["sysbus"].ReadByte(0x20005096) & 0xFB); open("/home/sslayer/hguv98-sim/pk3.bin","wb").write(bytes([m["sysbus"].ReadByte(0x20005096)]))'
emulation RunFor "00:00:00.100"
python 'm = emulationManager.CurrentEmulation.Machines[0]; m["sysbus"].WriteByte(0x20005096, m["sysbus"].ReadByte(0x20005096) & 0xFB); open("/home/sslayer/hguv98-sim/pk4.bin","wb").write(bytes([m["sysbus"].ReadByte(0x20005096)]))'
emulation RunFor "00:00:00.100"
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 0
echo "MARK release"
emulation RunFor "00:00:00.700"
python 'm = emulationManager.CurrentEmulation.Machines[0]; open("/home/sslayer/hguv98-sim/pkend.bin","wb").write(bytes([m["sysbus"].ReadByte(0x20005096)]))'
quit
