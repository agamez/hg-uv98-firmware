# ck4-key-orig-ramdump2.resc — Round N probe: dispatch-state bytes during a
# code-10 press: 0x20009450..0x20009490 (task flags incl. 0x20009452 bits) and
# 0x20006840..0x20006890 (0x2000687D active-state byte).
using sysbus
mach create "ck4keydump2"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006780
sysbus WriteDoubleWord 0x00000004 0x08044691
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadBinary @/home/sslayer/Proyectos/HG-UV98/firmware/MAIN-MCU-HG-UV98-V1.0.1-190416.bin 0x08004000
cpu AddHook 0x08042900 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(9, RegisterValue.Create(0x08040000, 32))"
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
emulation RunFor "00:00:01.990"
python 'm = emulationManager.CurrentEmulation.Machines[0]; open("/tmp/opencode/statedump_pre.bin","wb").write(bytes(m["sysbus"].ReadBytes(0x20009450, 0x40))); open("/tmp/opencode/statedump2_pre.bin","wb").write(bytes(m["sysbus"].ReadBytes(0x20006840, 0x50)))'
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 2330
echo "MARK press code10"
emulation RunFor "00:00:00.300"
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 0
echo "MARK release; dump"
python 'm = emulationManager.CurrentEmulation.Machines[0]; open("/tmp/opencode/statedump_rel.bin","wb").write(bytes(m["sysbus"].ReadBytes(0x20009450, 0x40))); open("/tmp/opencode/statedump2_rel.bin","wb").write(bytes(m["sysbus"].ReadBytes(0x20006840, 0x50)))'
emulation RunFor "00:00:00.500"
quit
