# p1-ticktest.resc - does the SysTick handler run at the hang?
using sysbus
mach create "ticktest"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006780
sysbus WriteDoubleWord 0x00000004 0x08044691
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadBinary @/home/sslayer/Proyectos/HG-UV98/firmware/MAIN-MCU-HG-UV98-V1.0.1-190416.bin 0x08004000
cpu AddHook 0x08042900 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(9, RegisterValue.Create(0x08040000, 32))"
cpu AddHook 0x0802bd69 "self.Log(LogLevel.Info, 'TICK')"
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
emulation RunFor "00:00:04.990"
python 'm = emulationManager.CurrentEmulation.Machines[0]; print("SYST@5 CTRL=0x%x LOAD=0x%x VAL=0x%x" % (m["sysbus"].ReadDoubleWord(0xE000E010), m["sysbus"].ReadDoubleWord(0xE000E014), m["sysbus"].ReadDoubleWord(0xE000E018)))'
python 'm = emulationManager.CurrentEmulation.Machines[0]; print("SHPR3=0x%x ICER=0x%x" % (m["sysbus"].ReadDoubleWord(0xE000ED20), m["sysbus"].ReadDoubleWord(0xE000E180)))'
python 'm = emulationManager.CurrentEmulation.Machines[0]; c = m["cpu"]; print("PRIMASK=" + str(c.IsHalted))'
emulation RunFor "00:00:05"
python 'm = emulationManager.CurrentEmulation.Machines[0]; c = m["cpu"]; print("PC10=" + str(c.GetRegister(15).RawValue))'
emulation RunFor "00:00:05"
python 'm = emulationManager.CurrentEmulation.Machines[0]; c = m["cpu"]; print("PC15=" + str(c.GetRegister(15).RawValue))'
emulation RunFor "00:00:05"
python 'm = emulationManager.CurrentEmulation.Machines[0]; c = m["cpu"]; print("PC20=" + str(c.GetRegister(15).RawValue))'
quit
