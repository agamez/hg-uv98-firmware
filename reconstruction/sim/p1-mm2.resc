# p1-mm2.resc - session 61: the mainmode scenario with the CORRECT (even,
# thumb-bit-cleared) hook addresses + per-epoch stream line counts. Answers:
# are the ticks/switches alive throughout, when does the display stream
# freeze, does the key injection produce anything.
using sysbus
mach create "mm2"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006780
sysbus WriteDoubleWord 0x00000004 0x08044691
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadBinary @/home/sslayer/Proyectos/HG-UV98/firmware/MAIN-MCU-HG-UV98-V1.0.1-190416.bin 0x08004000
cpu AddHook 0x08042900 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(9, RegisterValue.Create(0x08040000, 32))"
cpu AddHook 0x0802bd68 "self.Log(LogLevel.Info, 'SYSTICK_EVEN')"
cpu AddHook 0x0802b21a "self.Log(LogLevel.Info, 'PENDSV_EVEN')"
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
emulation RunFor "00:00:04.990"
python 'print("LINES_T5=" + str(sum(1 for _ in open("/home/sslayer/hguv98-sim/pb_stream.log"))))'
emulation RunFor "00:00:05"
python 'print("LINES_T10=" + str(sum(1 for _ in open("/home/sslayer/hguv98-sim/pb_stream.log"))))'
emulation RunFor "00:00:05"
python 'print("LINES_T15=" + str(sum(1 for _ in open("/home/sslayer/hguv98-sim/pb_stream.log"))))'
emulation RunFor "00:00:05"
python 'print("LINES_T20=" + str(sum(1 for _ in open("/home/sslayer/hguv98-sim/pb_stream.log"))))'
emulation RunFor "00:00:05"
python 'print("LINES_T25=" + str(sum(1 for _ in open("/home/sslayer/hguv98-sim/pb_stream.log"))))'
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 1
emulation RunFor "00:00:05"
python 'print("LINES_T30_POSTKEY=" + str(sum(1 for _ in open("/home/sslayer/hguv98-sim/pb_stream.log"))))'
quit
