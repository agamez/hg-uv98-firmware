# p3-key1-recon.resc - session 69: the recon mirror of p3-key1-orig.resc
# (the key-1 = ADC 2047, the hold 3 s -> the 40-pass screen 0x83).
using sysbus
mach create "p3k1rec"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006800
sysbus WriteDoubleWord 0x00000004 0x08004165
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadELF @/home/sslayer/Proyectos/HG-UV98/reconstruction/build/hguv98.elf
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
emulation RunFor "00:00:05.990"
echo "=== key-1 tag (2047) ==="
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 2047
emulation RunFor "00:00:03"
python "m = emulationManager.CurrentEmulation.Machines[0]; print('P1 scr=%02x L=%d' % (int(m['sysbus'].ReadByte(0x200050E8)), sum(1 for _ in open('/home/sslayer/hguv98-sim/pb_stream.log'))))"
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 0
emulation RunFor "00:00:01.5"
python "m = emulationManager.CurrentEmulation.Machines[0]; print('REL scr=%02x L=%d' % (int(m['sysbus'].ReadByte(0x200050E8)), sum(1 for _ in open('/home/sslayer/hguv98-sim/pb_stream.log'))))"
quit
