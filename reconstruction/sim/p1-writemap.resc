cpu AddHook 0x801ab98 "self.Log(LogLevel.Info, 'W2 801ab98 v=0x' + hex(self.GetRegister(0).RawValue) + '/' + hex(self.GetRegister(1).RawValue) + '/' + hex(self.GetRegister(2).RawValue))"
cpu AddHook 0x801ea70 "self.Log(LogLevel.Info, 'W2 801ea70 v=0x' + hex(self.GetRegister(0).RawValue) + '/' + hex(self.GetRegister(1).RawValue) + '/' + hex(self.GetRegister(2).RawValue))"
cpu AddHook 0x801ec88 "self.Log(LogLevel.Info, 'W2 801ec88 v=0x' + hex(self.GetRegister(0).RawValue) + '/' + hex(self.GetRegister(1).RawValue) + '/' + hex(self.GetRegister(2).RawValue))"
cpu AddHook 0x8022a4a "self.Log(LogLevel.Info, 'W2 8022a4a v=0x' + hex(self.GetRegister(0).RawValue) + '/' + hex(self.GetRegister(1).RawValue) + '/' + hex(self.GetRegister(2).RawValue))"
cpu AddHook 0x8022a6c "self.Log(LogLevel.Info, 'W2 8022a6c v=0x' + hex(self.GetRegister(0).RawValue) + '/' + hex(self.GetRegister(1).RawValue) + '/' + hex(self.GetRegister(2).RawValue))"
cpu AddHook 0x8024a70 "self.Log(LogLevel.Info, 'W2 8024a70 v=0x' + hex(self.GetRegister(0).RawValue) + '/' + hex(self.GetRegister(1).RawValue) + '/' + hex(self.GetRegister(2).RawValue))"
cpu AddHook 0x80254e2 "self.Log(LogLevel.Info, 'W2 80254e2 v=0x' + hex(self.GetRegister(0).RawValue) + '/' + hex(self.GetRegister(1).RawValue) + '/' + hex(self.GetRegister(2).RawValue))"
