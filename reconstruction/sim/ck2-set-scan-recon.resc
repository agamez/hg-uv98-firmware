# ck2-set-scan.resc — Round B/C: where do the injected settings land?
# Dump the full 64 KB SRAM after the marker-settings handshake; the host
# side searches for the 0xAB marker.
using sysbus
mach create "ck2setscanrecon"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006800
sysbus WriteDoubleWord 0x00000004 0x08004165
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadELF @/home/sslayer/Proyectos/HG-UV98/reconstruction/build/hguv98.elf
# no r9 hook
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
emulation RunFor "00:00:01.990"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A00,' + '0'*14 + ',' + chr(0xAB) + chr(0)*0x20 + chr(1) + chr(0) + chr(2) + chr(0)*476 + chr(13) + chr(10); [u.WriteChar(ord(c)) for c in frame]"
echo "MARK settings injected"
emulation RunFor "00:00:02.000"
python 'm = emulationManager.CurrentEmulation.Machines[0]; f = open("/home/sslayer/hguv98-sim/ramscan_recon.bin","wb"); f.write(bytes(m["sysbus"].ReadBytes(0x20000000, 0x10000))); f.close()'
quit
