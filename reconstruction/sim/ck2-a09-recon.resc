# ck2-a09-orig.resc — Round B/C item 1: the $A09 side-key beacon trigger.
# Protocol: boot 10 ms -> 2 s -> the neutral $A00 handshake (534 B) -> 1 s ->
# inject "$A09\r\n" (6 B) -> 2 s -> dump the state bytes. The beacon states
# 'h'/'i'/'j' (0x68/0x69/0x6A) live at UI_STATE_ADDR 0x200050E8.
using sysbus
mach create "ck2a09recon"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006800
sysbus WriteDoubleWord 0x00000004 0x08004165
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadELF @/home/sslayer/Proyectos/HG-UV98/reconstruction/build/hguv98.elf
cpu # (no r9 hook for the recon)
showAnalyzer sysbus.usart2
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
emulation RunFor "00:00:01.990"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A00,' + '0'*14 + ',' + chr(0)*512 + chr(13) + chr(10); assert len(frame) == 534, 'frame must be 534 bytes'; [u.WriteChar(ord(c)) for c in frame]"
echo "MARK a00 injected"
emulation RunFor "00:00:01.000"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; [u.WriteChar(ord(c)) for c in chr(36)+'A09'+chr(13)+chr(10)]"
echo "MARK a09 injected"
emulation RunFor "00:00:02.000"
python 'm = emulationManager.CurrentEmulation.Machines[0]; f = open("/home/sslayer/hguv98-sim/a09_state_recon.bin","wb"); f.write(bytes(m["sysbus"].ReadBytes(0x200050E0, 0x20))); f.close()'
python 'm = emulationManager.CurrentEmulation.Machines[0]; f = open("/home/sslayer/hguv98-sim/a09_state2_recon.bin","wb"); f.write(bytes(m["sysbus"].ReadBytes(0x20005150, 0x20))); f.close()'
quit
