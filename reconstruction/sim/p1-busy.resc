# p1-busy.resc - session 61: who arms byte11 bit1 (the exit-blocking busy)?
# Hook the exit's bit1 check (r0 = the bit value), the early-return site,
# and the enter's busy-set store. All rare.
using sysbus
mach create "busy"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006780
sysbus WriteDoubleWord 0x00000004 0x08044691
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadBinary @/home/sslayer/Proyectos/HG-UV98/firmware/MAIN-MCU-HG-UV98-V1.0.1-190416.bin 0x08004000
cpu AddHook 0x08042900 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(9, RegisterValue.Create(0x08040000, 32))"
cpu AddHook 0x08024A8C "self.Log(LogLevel.Info, 'EV exit_busychk bit=' + str(self.GetRegister(0).RawValue))"
cpu AddHook 0x08024A98 "self.Log(LogLevel.Info, 'EV exit_earlyret')"
cpu AddHook 0x08024952 "self.Log(LogLevel.Info, 'EV enter_busyset')"
cpu AddHook 0x0802490E "self.Log(LogLevel.Info, 'EV enter')"
cpu AddHook 0x08024A1A "self.Log(LogLevel.Info, 'EV exitfn')"
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
emulation RunFor "00:00:09.990"
python "m = emulationManager.CurrentEmulation.Machines[0]; print('T10 b6=%02x b11=%02x band=%02x' % (int(m['sysbus'].ReadByte(0x20005096)), int(m['sysbus'].ReadByte(0x2000509B)), int(m['sysbus'].ReadByte(0x200050E8))))"
emulation RunFor "00:00:10"
python "m = emulationManager.CurrentEmulation.Machines[0]; print('T20 b6=%02x b11=%02x band=%02x' % (int(m['sysbus'].ReadByte(0x20005096)), int(m['sysbus'].ReadByte(0x2000509B)), int(m['sysbus'].ReadByte(0x200050E8))))"
quit
