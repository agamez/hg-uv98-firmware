emulation RunFor "00:00:00.300"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A01,' + chr(0)*512 + chr(13) + chr(10); assert len(frame) == 519; [u.WriteChar(ord(c)) for c in frame]"
emulation RunFor "00:00:01"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A01,' + chr(0)*512 + chr(13) + chr(10); [u.WriteChar(ord(c)) for c in frame]"
emulation RunFor "00:00:01"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A01,' + chr(0)*512 + chr(13) + chr(10); [u.WriteChar(ord(c)) for c in frame]"
emulation RunFor "00:00:02"
python "m = emulationManager.CurrentEmulation.Machines[0]; b = m['sysbus'].ReadBytes(0x20005090, 0x10); print('T7 b2=%02x b6=%02x b8=%02x L=%d' % (int(b[2]), int(b[6]), int(b[8]), sum(1 for _ in open('/home/sslayer/hguv98-sim/pb_stream.log'))))"
echo "=== key tag ADC2_DR = 2000 at 10 s ==="
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 2000
emulation RunFor "00:00:02"
python "m = emulationManager.CurrentEmulation.Machines[0]; b = m['sysbus'].ReadBytes(0x20005090, 0x10); print('T12 b2=%02x b6=%02x L=%d' % (int(b[2]), int(b[6]), sum(1 for _ in open('/home/sslayer/hguv98-sim/pb_stream.log'))))"
emulation RunFor "00:00:03"
python "m = emulationManager.CurrentEmulation.Machines[0]; b = m['sysbus'].ReadBytes(0x20005090, 0x10); print('T15 b2=%02x b6=%02x L=%d' % (int(b[2]), int(b[6]), sum(1 for _ in open('/home/sslayer/hguv98-sim/pb_stream.log'))))"
emulation RunFor "00:00:05"
python "m = emulationManager.CurrentEmulation.Machines[0]; b = m['sysbus'].ReadBytes(0x20005090, 0x10); print('T20 b2=%02x b6=%02x L=%d' % (int(b[2]), int(b[6]), sum(1 for _ in open('/home/sslayer/hguv98-sim/pb_stream.log'))))"
quit
