python "m = emulationManager.CurrentEmulation.Machines[0]; print('T20 dwell=%02x/%02x cnt=%04x mode=%02x scanfl=%02x b6=%02x b8=%02x' % (int(m['sysbus'].ReadByte(0x20004E82)), int(m['sysbus'].ReadByte(0x20004E83)), int(m['sysbus'].ReadWord(0x20004720)) & 0xFFFF, int(m['sysbus'].ReadByte(0x20004E86)), int(m['sysbus'].ReadByte(0x20004E97)), int(m['sysbus'].ReadByte(0x20005096)), int(m['sysbus'].ReadByte(0x20005098))))"
