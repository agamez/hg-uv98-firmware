python 'm = emulationManager.CurrentEmulation.Machines[0]; sb = m["sysbus"]; f = open("/home/sslayer/hguv98-sim/smeter_ctx.bin","wb"); import array; d = bytes(sb.ReadBytes(0x2000469c, 0x140)); f.write(d); f.close(); f2 = open("/home/sslayer/hguv98-sim/smeter_flags.bin","wb"); f2.write(bytes(sb.ReadBytes(0x20005094, 0x10))); f2.close()'
quit
