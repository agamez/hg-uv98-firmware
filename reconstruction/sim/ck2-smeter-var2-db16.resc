# ck2-smeter-poke.resc — Round B/C/§9: S-meter sweep, attempt 1 (proof of life).
# The updater 0x080203D0 is gated: FLAG_BANK+0 bit6 (caller 0x08014DEA) +
# FLAG_BANK+0 bit7 (one-shot enable) + FLAG_BANK+2 bit2 == 0 (menu gate).
# Poke all three per 50 ms slice; hook the RSSI read return (0x08020468,
# r0 = rf_read raw -> >>8 = dB), the ring write 0x801A8DA, the render 0x801AB36.
using sysbus
mach create "ck2smeter"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006780
sysbus WriteDoubleWord 0x00000004 0x08044691
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadBinary @/home/sslayer/Proyectos/HG-UV98/firmware/MAIN-MCU-HG-UV98-V1.0.1-190416.bin 0x08004000
cpu AddHook 0x08042900 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(9, RegisterValue.Create(0x08040000, 32))"
cpu AddHook 0x080203f8 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(0, RegisterValue.Create(0, 32))"
cpu AddHook 0x0801e2a0 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(0, RegisterValue.Create(1, 32))"
cpu AddHook 0x08020468 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(0, RegisterValue.Create(0x1000, 32)); self.Log(LogLevel.Info, 'SMETER_DB override 16')"
cpu AddHook 0x08014f04 "self.Log(LogLevel.Info, 'CALLER_HIT bit6 path')"
cpu AddHook 0x08014e1c "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(0, RegisterValue.Create(1, 32))"
cpu AddHook 0x08014efe "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(0, RegisterValue.Create(1, 32))"
cpu AddHook 0x08014f04 "self.Log(LogLevel.Info, 'CALLER_HIT')"
cpu AddHook 0x08020408 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(0, RegisterValue.Create(1, 32))"
cpu AddHook 0x080203d0 "self.Log(LogLevel.Info, 'UPDATER_ENTRY')"
cpu AddHook 0x0801e2a0 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(0, RegisterValue.Create(1, 32))"
cpu AddHook 0x08020468 "self.Log(LogLevel.Info, 'SMETER_DB raw=0x' + hex(self.GetRegister(0).RawValue))"
cpu AddHook 0x0801a8da "self.Log(LogLevel.Info, 'SMETER_RING ts=0x' + hex(self.GetRegister(0).RawValue) + ' lr=0x' + hex(self.GetRegister(14).RawValue))"
cpu AddHook 0x0801ab36 "self.Log(LogLevel.Info, 'SMETER_RENDER band=' + str(self.GetRegister(0).RawValue) + ' e1=0x' + hex(self.GetRegister(1).RawValue) + ' e2=0x' + hex(self.GetRegister(2).RawValue) + ' e3=0x' + hex(self.GetRegister(3).RawValue))"
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
emulation RunFor "00:00:01.990"
echo "MARK pokes start"
emulation RunFor "00:00:00.020"
python "m = emulationManager.CurrentEmulation.Machines[0]; sb = m['sysbus']; v = sb.ReadByte(0x20005094); sb.WriteByte(0x20005094, v | 0xC0); w = sb.ReadByte(0x20005096); sb.WriteByte(0x20005096, w & 0xFB)"
emulation RunFor "00:00:00.020"
python "m = emulationManager.CurrentEmulation.Machines[0]; sb = m['sysbus']; v = sb.ReadByte(0x20005094); sb.WriteByte(0x20005094, v | 0xC0); w = sb.ReadByte(0x20005096); sb.WriteByte(0x20005096, w & 0xFB)"
emulation RunFor "00:00:00.020"
python "m = emulationManager.CurrentEmulation.Machines[0]; sb = m['sysbus']; v = sb.ReadByte(0x20005094); sb.WriteByte(0x20005094, v | 0xC0); w = sb.ReadByte(0x20005096); sb.WriteByte(0x20005096, w & 0xFB)"
emulation RunFor "00:00:00.020"
