# ck4-key-orig-flowtrace3.resc — Round N probe: pokes + full gate trace.
# Hooks: G1 0x8019e88, G2 0x8019f24, MENU 0x8019f30, MAIN 0x8019fea, V 0x801a1e6.
# Full struct dump 0x20005080..0x200050D0 during the hold (covers 0x200050A0).
using sysbus
mach create "ck4keyflow3"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006780
sysbus WriteDoubleWord 0x00000004 0x08044691
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadBinary @/home/sslayer/Proyectos/HG-UV98/firmware/MAIN-MCU-HG-UV98-V1.0.1-190416.bin 0x08004000
cpu AddHook 0x08042900 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(9, RegisterValue.Create(0x08040000, 32))"
cpu AddHook 0x08019e88 "self.Log(LogLevel.Info, 'G1')"
cpu AddHook 0x08019f24 "self.Log(LogLevel.Info, 'G2')"
cpu AddHook 0x08019f30 "self.Log(LogLevel.Info, 'MENU')"
cpu AddHook 0x08019fea "self.Log(LogLevel.Info, 'MAIN')"
cpu AddHook 0x0801a1e6 "self.Log(LogLevel.Info, 'V')"
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
emulation RunFor "00:00:01.990"
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 2330
echo "MARK press + poke"
python 'm = emulationManager.CurrentEmulation.Machines[0]; m["sysbus"].WriteByte(0x20005096, m["sysbus"].ReadByte(0x20005096) & 0xFB)'
emulation RunFor "00:00:00.250"
python 'm = emulationManager.CurrentEmulation.Machines[0]; m["sysbus"].WriteByte(0x20005096, m["sysbus"].ReadByte(0x20005096) & 0xFB); open("/home/sslayer/hguv98-sim/flow3_hold.bin","wb").write(bytes(m["sysbus"].ReadBytes(0x20005080, 0x50)))'
emulation RunFor "00:00:00.250"
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 0
echo "MARK release"
emulation RunFor "00:00:00.700"
quit
