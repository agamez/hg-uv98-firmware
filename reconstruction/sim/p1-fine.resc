# p1-fine.resc - session 61: fine-grained byte6/byte2 watch around the T10
# exit event. 1 s epochs, T7..T13, plus the display-line deltas.
using sysbus
mach create "fine"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006780
sysbus WriteDoubleWord 0x00000004 0x08044691
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadBinary @/home/sslayer/Proyectos/HG-UV98/firmware/MAIN-MCU-HG-UV98-V1.0.1-190416.bin 0x08004000
cpu AddHook 0x08042900 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(9, RegisterValue.Create(0x08040000, 32))"
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
emulation RunFor "00:00:06.990"
python "m = emulationManager.CurrentEmulation.Machines[0]; b = m['sysbus'].ReadBytes(0x20005090, 0x14); print('T7 b2=%02x b6=%02x b9=%02x L=%d' % (int(b[2]), int(b[6]), int(b[9]), sum(1 for _ in open('/home/sslayer/hguv98-sim/pb_stream.log'))))"
emulation RunFor "00:00:01"
python "m = emulationManager.CurrentEmulation.Machines[0]; b = m['sysbus'].ReadBytes(0x20005090, 0x14); print('T8 b2=%02x b6=%02x b9=%02x L=%d' % (int(b[2]), int(b[6]), int(b[9]), sum(1 for _ in open('/home/sslayer/hguv98-sim/pb_stream.log'))))"
emulation RunFor "00:00:01"
