# ck4-key-orig-flowtrace.resc — Round N probe: which dispatch gate eats the key?
# Hook chain: G1=inhibit gate 0x8019e88, G2=menu/main split 0x8019f24,
# G3=main mode 0x8019fea, G4=digit path 0x801a1ba, V=digit vtable 0x801a1e6.
# State bytes dumped DURING the hold.
using sysbus
mach create "ck4keyflow"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006780
sysbus WriteDoubleWord 0x00000004 0x08044691
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadBinary @/home/sslayer/Proyectos/HG-UV98/firmware/MAIN-MCU-HG-UV98-V1.0.1-190416.bin 0x08004000
cpu AddHook 0x08042900 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(9, RegisterValue.Create(0x08040000, 32))"
cpu AddHook 0x08019e88 "self.Log(LogLevel.Info, 'G1_inhibit_pass')"
cpu AddHook 0x08019f24 "self.Log(LogLevel.Info, 'G2_split')"
cpu AddHook 0x08019fea "self.Log(LogLevel.Info, 'G3_mainmode')"
cpu AddHook 0x0801a1ba "self.Log(LogLevel.Info, 'G4_digitpath')"
cpu AddHook 0x0801a1e6 "self.Log(LogLevel.Info, 'V_vtable')"
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
emulation RunFor "00:00:01.990"
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 2330
echo "MARK press code10"
emulation RunFor "00:00:00.500"
python 'm = emulationManager.CurrentEmulation.Machines[0]; open("/home/sslayer/hguv98-sim/statedump_hold.bin","wb").write(bytes(m["sysbus"].ReadBytes(0x20009450, 0x40))); open("/home/sslayer/hguv98-sim/statedump2_hold.bin","wb").write(bytes(m["sysbus"].ReadBytes(0x20006840, 0x50)))'
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 0
echo "MARK release"
emulation RunFor "00:00:00.300"
quit
