# p1-force.resc - session 61: the decisive test. Force byte6 bit2 = 0 at T12
# (after the exit consumed the busy bit), then inject the key. If the UI
# renders and key_event fires, the session bit is the sole blocker.
using sysbus
mach create "force"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006780
sysbus WriteDoubleWord 0x00000004 0x08044691
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadBinary @/home/sslayer/Proyectos/HG-UV98/firmware/MAIN-MCU-HG-UV98-V1.0.1-190416.bin 0x08004000
cpu AddHook 0x08042900 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(9, RegisterValue.Create(0x08040000, 32))"
cpu AddHook 0x0801E044 "self.Log(LogLevel.Info, 'EV key_event id=' + str(self.GetRegister(0).RawValue))"
cpu AddHook 0x0802490E "self.Log(LogLevel.Info, 'EV sess_enter')"
cpu AddHook 0x08024A1A "self.Log(LogLevel.Info, 'EV sess_exit')"
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
emulation RunFor "00:00:11.990"
python "m = emulationManager.CurrentEmulation.Machines[0]; print('T12 b6=%02x L=%d' % (int(m['sysbus'].ReadByte(0x20005096)), sum(1 for _ in open('/home/sslayer/hguv98-sim/pb_stream.log'))))"
echo "=== force byte6 bit2 = 0 (keep bit1) ==="
sysbus WriteByte 0x20005096 0x02
echo "=== tag ADC2_DR = 2000 (the key) ==="
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 2000
emulation RunFor "00:00:02"
python "m = emulationManager.CurrentEmulation.Machines[0]; b = m['sysbus'].ReadBytes(0x20005090, 0x10); print('T14 b2=%02x b6=%02x L=%d' % (int(b[2]), int(b[6]), sum(1 for _ in open('/home/sslayer/hguv98-sim/pb_stream.log'))))"
emulation RunFor "00:00:05"
python "m = emulationManager.CurrentEmulation.Machines[0]; b = m['sysbus'].ReadBytes(0x20005090, 0x10); print('T19 b2=%02x b6=%02x L=%d' % (int(b[2]), int(b[6]), sum(1 for _ in open('/home/sslayer/hguv98-sim/pb_stream.log'))))"
quit
