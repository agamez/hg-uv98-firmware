# p1-watch-orig.resc — Phase 1: the flag-bank writer hunt via GDB watchpoints.
# Original image, GDB server on 3334; the external gdb-multiarch sets the
# hardware watchpoints on 0x20005094 (byte 0) and 0x20005096 (byte 2).
using sysbus
mach create "watchorig"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006780
sysbus WriteDoubleWord 0x00000004 0x08044691
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadBinary @/home/sslayer/Proyectos/HG-UV98/firmware/MAIN-MCU-HG-UV98-V1.0.1-190416.bin 0x08004000
cpu AddHook 0x08042900 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(9, RegisterValue.Create(0x08040000, 32))"
echo "MARK gdb server up"
cpu AddHook 0x8024b0c "self.Log(LogLevel.Info, 'EXITPATH B0C_24d6c')"
cpu AddHook 0x8024b3a "self.Log(LogLevel.Info, 'EXITPATH B3A_689a')"
cpu AddHook 0x8024b5a "self.Log(LogLevel.Info, 'EXITPATH B5A_19d4c')"
cpu AddHook 0x8024b5e "self.Log(LogLevel.Info, 'EXITPATH B5E_22a24')"
cpu AddHook 0x8024be6 "self.Log(LogLevel.Info, 'EXITPATH BE6_1e240')"
cpu AddHook 0x8024bf8 "self.Log(LogLevel.Info, 'EXITPATH BF8_22044')"
cpu AddHook 0x8024c04 "self.Log(LogLevel.Info, 'EXITPATH C06_14128')"
cpu AddHook 0x8024c0a "self.Log(LogLevel.Info, 'EXITPATH C0A_delay50')"
cpu AddHook 0x8024c10 "self.Log(LogLevel.Info, 'EXITPATH C10_BIT2CLR')"
cpu AddHook 0x8024a66 "self.Log(LogLevel.Info, 'EXITPATH A66_27bc6')"
cpu AddHook 0x8024a9a "self.Log(LogLevel.Info, 'EXITPATH A9A_work')"
emulation RunFor "00:00:00.100"
python 'm = emulationManager.CurrentEmulation.Machines[0]; f = open("/tmp/opencode/fbscanD_000.bin","wb"); f.write(bytes(m["sysbus"].ReadBytes(0x20005096, 1))); f.close()'

