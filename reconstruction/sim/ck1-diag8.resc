# CK1-diag8 — log the exception ID on every interrupt entry/exit.
using sysbus
mach create "hguv98"
machine LoadPlatformDescription @platforms/cpus/stm32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006800
sysbus WriteDoubleWord 0x00000004 0x08004165
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadELF @/home/sslayer/Proyectos/HG-UV98/reconstruction/build/hguv98.elf
sysbus.cpu AddHookAtInterruptBegin "self.Log(LogLevel.Info, 'IRQ-BEGIN id=' + str(self.IRQ) + ' pc=' + hex(self.PC.RawValue))"
sysbus.cpu AddHookAtInterruptEnd "self.Log(LogLevel.Info, 'IRQ-END id=' + str(self.IRQ))"
emulation RunFor "00:00:00.030"
echo "=== heartbeat:"
sysbus ReadWord 0x20004802
quit
