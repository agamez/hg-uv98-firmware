# p1-peer3.resc - session 61: the peer flow + the key injection. The $A00
# response window (0.7-2.7 s) + the $A01 cadence + the ADC2 key tag at 12 s;
# the display-stream deltas pre/post key + the flag reads.
using sysbus
mach create "peer3"
machine LoadPlatformDescription @/home/sslayer/Proyectos/HG-UV98/reconstruction/sim/gd32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006780
sysbus WriteDoubleWord 0x00000004 0x08044691
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadBinary @/home/sslayer/Proyectos/HG-UV98/firmware/MAIN-MCU-HG-UV98-V1.0.1-190416.bin 0x08004000
cpu AddHook 0x08042900 "from Antmicro.Renode.Peripherals.CPU import RegisterValue; self.SetRegister(9, RegisterValue.Create(0x08040000, 32))"
emulation RunFor "00:00:00.010"
sysbus WriteDoubleWord 0xE000E018 0x00000000
emulation RunFor "00:00:00.690"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A00,' + '0'*14 + ',' + chr(0)*512 + chr(13) + chr(10); assert len(frame) == 534; [u.WriteChar(ord(c)) for c in frame]"
emulation RunFor "00:00:00.100"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A00,' + '0'*14 + ',' + chr(0)*512 + chr(13) + chr(10); [u.WriteChar(ord(c)) for c in frame]"
emulation RunFor "00:00:00.100"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A00,' + '0'*14 + ',' + chr(0)*512 + chr(13) + chr(10); [u.WriteChar(ord(c)) for c in frame]"
emulation RunFor "00:00:00.100"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A00,' + '0'*14 + ',' + chr(0)*512 + chr(13) + chr(10); [u.WriteChar(ord(c)) for c in frame]"
emulation RunFor "00:00:00.100"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A00,' + '0'*14 + ',' + chr(0)*512 + chr(13) + chr(10); [u.WriteChar(ord(c)) for c in frame]"
emulation RunFor "00:00:00.100"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A00,' + '0'*14 + ',' + chr(0)*512 + chr(13) + chr(10); [u.WriteChar(ord(c)) for c in frame]"
emulation RunFor "00:00:00.100"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A00,' + '0'*14 + ',' + chr(0)*512 + chr(13) + chr(10); [u.WriteChar(ord(c)) for c in frame]"
emulation RunFor "00:00:00.100"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A00,' + '0'*14 + ',' + chr(0)*512 + chr(13) + chr(10); [u.WriteChar(ord(c)) for c in frame]"
emulation RunFor "00:00:00.100"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A00,' + '0'*14 + ',' + chr(0)*512 + chr(13) + chr(10); [u.WriteChar(ord(c)) for c in frame]"
emulation RunFor "00:00:00.100"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A00,' + '0'*14 + ',' + chr(0)*512 + chr(13) + chr(10); [u.WriteChar(ord(c)) for c in frame]"
echo "=== A00 window done; the A01 cadence ==="
emulation RunFor "00:00:00.300"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A01,' + chr(0)*512 + chr(13) + chr(10); assert len(frame) == 519; [u.WriteChar(ord(c)) for c in frame]"
emulation RunFor "00:00:01"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A01,' + chr(0)*512 + chr(13) + chr(10); [u.WriteChar(ord(c)) for c in frame]"
emulation RunFor "00:00:01"
python "m = emulationManager.CurrentEmulation.Machines[0]; u = m['sysbus.usart2']; frame = chr(36) + 'A01,' + chr(0)*512 + chr(13) + chr(10); [u.WriteChar(ord(c)) for c in frame]"
emulation RunFor "00:00:03"
python "m = emulationManager.CurrentEmulation.Machines[0]; a = m['sysbus'].ReadBytes(0x20005090, 0x30); print('FLAGS_T7=' + ''.join('%02x' % b for b in a))"
emulation RunFor "00:00:05"
echo "=== key tag on (ADC2_DR = 1) at ~12 s guest ==="
sysbus Tag <0x4001284C 0x4> "ADC2_DR" 1
emulation RunFor "00:00:05"
python "m = emulationManager.CurrentEmulation.Machines[0]; print('LINES_PREKEY12_17=' + str(sum(1 for _ in open('/home/sslayer/hguv98-sim/pb_stream.log'))))"
emulation RunFor "00:00:05"
python "m = emulationManager.CurrentEmulation.Machines[0]; print('LINES_POSTKEY17_22=' + str(sum(1 for _ in open('/home/sslayer/hguv98-sim/pb_stream.log')))); a = m['sysbus'].ReadBytes(0x20005090, 0x30); print('FLAGS_T22=' + ''.join('%02x' % b for b in a))"
emulation RunFor "00:00:05"
python "m = emulationManager.CurrentEmulation.Machines[0]; print('LINES_POSTKEY22_27=' + str(sum(1 for _ in open('/home/sslayer/hguv98-sim/pb_stream.log')))); a = m['sysbus'].ReadBytes(0x20005090, 0x30); print('FLAGS_T27=' + ''.join('%02x' % b for b in a))"
quit
