# CK1-diag9 — count the tick chain stages over 30 ms.
using sysbus
mach create "hguv98"
machine LoadPlatformDescription @platforms/cpus/stm32f103.repl
sysbus WriteDoubleWord 0x00000000 0x20006800
sysbus WriteDoubleWord 0x00000004 0x08004165
sysbus Tag <0x40021004, 0x40021007> "RCC_CFGR" 0x00000008
sysbus LoadELF @/home/sslayer/Proyectos/HG-UV98/reconstruction/build/hguv98.elf
cpu AddHook 0x08005A88 "self.Log(LogLevel.Info, 'TICK: SysTickHandler')"
cpu AddHook 0x08005244 "self.Log(LogLevel.Info, 'TICK: OSIntEnter')"
cpu AddHook 0x0800536C "self.Log(LogLevel.Info, 'TICK: OSTimeTick')"
cpu AddHook 0x08005264 "self.Log(LogLevel.Info, 'TICK: OSIntExit')"
cpu AddHook 0x08005438 "self.Log(LogLevel.Info, 'TICK: OS_Sched')"
emulation RunFor "00:00:00.030"
echo "=== heartbeat:"
sysbus ReadWord 0x20004802
quit
